---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Education from "../components/Education.astro";
import Skills from "../components/Skills.astro";

import { Github, Linkedin, Instagram, Download } from "lucide-astro";
---

<Layout title="Portafolio" >
  <section id="home" class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content reveal">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span data-label="hero.badge">Disponible para proyectos</span>
          </div>

          <h1 class="hero-title">
            Hi, I'm <span class="text-gradient">Smith</span>
          </h1>

          <p class="hero-subtitle" data-label="hero.subtitle">
            Desarrollador de Software especializado en crear experiencias
            digitales únicas y memorables.
          </p>

          <div class="hero-actions">
            <a href="#projects" class="btn-primary">
              <span data-label="hero.viewProjects">Ver proyectos</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
            <a href="#contact" class="btn-secondary"> <span data-label="hero.contact">Contactar</span> </a>
          </div>

          <div class="hero-social-wrapper">
            <div class="hero-social">
              <a
                href="https://github.com/Smith-Muri"
                target="_blank"
                rel="noopener"
                class="social-link"
                aria-label="GitHub"
              >
                <Github class="w-5 h-5" />
              </a>
              <a
                href="https://www.linkedin.com/in/smith-murillo/"
                target="_blank"
                rel="noopener"
                class="social-link"
                aria-label="LinkedIn"
              >
                <Linkedin class="w-5 h-5" />
              </a>
              <a
                href="https://www.instagram.com/smith.tth/"
                target="_blank"
                rel="noopener"
                class="social-link"
                aria-label="Instagram"
              >
                <Instagram class="w-5 h-5" />
              </a>
            </div>

            <div class="divider"></div>

            <a
              href="/cv/Smith_Murillo_CV.pdf"
              download="Smith_Murillo_CV.pdf"
              class="cv-button"
              data-i18n="hero.downloadCV"
            >
              <Download class="w-5 h-5" />
              <span data-label="hero.downloadCV">Descargar CV</span>
            </a>
          </div>
        </div>
        
        <div class="hero-image reveal delay-200">
          <div class="image-wrapper">
            <div class="image-glow"></div>
            <img
              src="/images/smith.jpg"
              alt="Smith - Desarrollador Web"
              class="profile-photo"
            />
            <div class="image-border"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="container">
      <div class="section-header reveal">
        <h2 data-label="about.title">Sobre mí</h2>
        <div class="section-divider"></div>
      </div>

      <div class="about-content reveal delay-100">
        <div class="about-text">
          <p data-label="about.text1">
            Estudiante de Tecnología en Desarrollo de Software con pasión por
            crear aplicaciones web innovadoras y funcionales. Me especializo en
            el desarrollo backend, pero también tengo experiencia en frontend y
            bases de datos.
          </p>
          <p data-label="about.text2">
            Utilizo tecnologías modernas como React, Astro, Tailwind CSS y
            Node.js para construir experiencias de usuario fluidas. Mi enfoque
            combina principios simples del diseño con principios SOLID.
          </p>
          <p data-label="about.text3">
            Fuera del código, disfruto de los videojuegos, estudiar sobre
            desarrollo de software, ademas de mejorar mis habilidades tecnicas
            con retos de programacion.
          </p>
        </div>

        <div class="about-stats">
          <div class="stat-item">
            <div class="stat-value">1.5+</div>
            <div class="stat-label" data-label="about.experience">Años de experiencia</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">0</div>
            <div class="stat-label" data-label="about.projects">Proyectos completados</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">2</div>
            <div class="stat-label" data-label="about.clients">Clientes satisfechos</div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section id="projects">
    <div class="container">
      <div class="section-header reveal">
        <h2 data-label="projects.title">Proyectos destacados</h2>
        <div class="section-divider"></div>
      </div>

      <div class="projects-grid reveal delay-100">
        <ProjectCard
          title="Sitio Web de Modelaje"
          titleKey="projects.modelWeb.title"
          description="Sitio web sobre modalej, donde abarca varios modelos, eventos, cultara y mercado de la Moda."
          descriptionKey="projects.modelWeb.description"
          tags={["React", "TypeScrit", ".NET C#", "SQL Server"]}
          href="#"
        />
        <ProjectCard
          title="Portfolio"
          titleKey="projects.portfolio.title"
          description="Portafolio personal."
          descriptionKey="projects.portfolio.description"
          tags={["Astro", "Tailwind", "Node.js"]}
          href="#"
        />
        <ProjectCard
          title="Proximamente"
          titleKey="projects.upcoming.title"
          description="Proximamente."
          descriptionKey="projects.upcoming.description"
          tags={["JavaScript"]}
          href="#"
        />
      </div>
    </div>
  </section>

  <Skills />


  <Education />
  <section id="contact">
    <div class="container">
      <div class="contact-wrapper reveal">
        <div class="contact-info">
          <h2 data-label="contact.title">¿Hablamos?</h2>
          <p data-label="contact.description">
            Estoy abierto a nuevos proyectos y nuevas oportunidades. ¡No dudes
            en contactarme!
          </p>

          <div class="contact-details">
            <div class="contact-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>edwin.murillo@globant.com</span>
            </div>
            <div class="contact-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span data-label="contact.location">Medellín, Colombia</span>
            </div>
          </div>
        </div>

        <form class="contact-form" action="https://formspree.io/f/mzddzkoa" method="POST">
          <div class="form-group">
            <label for="name" data-label="contact.name">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Nombre Completo"
              required
            />
          </div>

          <div class="form-group">
            <label for="email" data-label="contact.email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Correo Electronico"
              required
            />
          </div>

          <div class="form-group">
            <label for="message" data-label="contact.message">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Cuéntame sobre tu idea..."
              required></textarea>
          </div>

          <button type="submit" class="btn-primary">
            <span data-label="contact.send">Enviar mensaje</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m22 2-7 20-4-9-9-4Z"></path>
              <path d="M22 2 11 13"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 4rem 0;
  }

  .hero-grid {
    display: grid;
    gap: 4rem;
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
    }
  }

  .hero-content {
    max-width: 600px;
  }

  @media (min-width: 768px) {
    .hero-content {
      text-align: left;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 2rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--primary-light);
    margin-bottom: 2rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .hero-title {
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--muted);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-social-wrapper {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: 1rem;
  }

  .divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid var(--primary);
    border-radius: 0.75rem;
    color: var(--primary-light);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .cv-button:hover {
    background: var(--primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
  }

  .cv-button svg {
    transition: transform 0.3s ease;
  }

  .cv-button:hover svg {
    transform: translateY(2px);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    color: var(--muted);
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--primary);
    color: var(--primary-light);
    transform: translateY(-2px);
  }

  @media (min-width: 768px) {
    .hero-social-wrapper {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .hero-social-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .divider {
      display: none;
    }

    .cv-button {
      width: 100%;
      justify-content: center;
    }
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: contain; 
    object-position: center;
    border-radius: 2rem;
    position: relative;
    z-index: 2;
    transition: transform 0.5s ease;
    background: linear-gradient(
      135deg,
      rgba(17, 17, 17, 0.8),
      rgba(30, 30, 30, 0.8)
    );
    padding: 1rem; 
  }

  .image-wrapper:hover .profile-photo {
    transform: scale(1.05);
  }

  .image-border {
    position: absolute;
    inset: -4px;
    border-radius: 2rem;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--primary-light),
      transparent
    );
    z-index: 1;
    opacity: 0.6;
    transition: opacity 0.5s ease;
  }

  .image-wrapper:hover .image-border {
    opacity: 1;
  }

  .image-glow {
    position: absolute;
    inset: -60px;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.3) 0%,
      transparent 70%
    );
    z-index: 0;
    animation: glow-pulse 3s ease-in-out infinite;
    opacity: 0.5;
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.05);
    }
  }

  @media (max-width: 768px) {
    .image-wrapper {
      max-width: 320px;
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-divider {
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    border-radius: 2px;
    margin: 1rem auto 0;
  }


  .about-content {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .about-content {
      grid-template-columns: 2fr 1fr;
    }
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-text p {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 1rem;
    height: fit-content;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(
      135deg,
      var(--primary-light),
      var(--primary-dark)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .projects-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }


  .contact-wrapper {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .contact-wrapper {
      grid-template-columns: 1fr 1.5fr;
    }
  }

  .contact-info h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .contact-info p {
    margin-bottom: 2rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
  }

  .contact-item svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-form .btn-primary {
    width: 100%;
    justify-content: center;
  }
</style>
