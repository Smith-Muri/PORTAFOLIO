---
const { siteTitle = "Smith" } = Astro.props;
---

<nav role="navigation" aria-label="Main navigation" class="nav-container">
  <div class="nav-wrapper">
    <a href="/#home" class="site-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="logo-icon">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <span class="logo-text">{siteTitle}</span>
    </a>
    
    <!-- Desktop Navigation -->
    <div class="nav-links nav-desktop" id="nav-desktop">
      <a href="/#home" class="nav-link" data-label="nav.home">Inicio</a>
      <a href="/#about" class="nav-link" data-label="nav.about">Sobre mí</a>
      <a href="/#projects" class="nav-link" data-label="nav.projects">Proyectos</a>
      <a href="/#skills" class="nav-link" data-label="nav.skills">Habilidades</a>
      <a href="/#education" class="nav-link" data-label="nav.education">Educación</a>
      <a href="/#contact" class="nav-link" data-label="nav.contact">Contacto</a>
    </div>

    <!-- Language and Mobile Menu Buttons -->
    <div class="nav-controls">
      <!-- Language Selector -->
      <button class="language-btn" id="language-btn" aria-label="Change language" title="Cambiar idioma">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          <line x1="2" y1="12" x2="22" y2="12"></line>
        </svg>
        <span class="lang-text">ES</span>
      </button>

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" id="mobile-menu-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Language Dropdown -->
  <div class="language-dropdown" id="language-dropdown">
    <button class="lang-option" data-lang="es">
      <span class="flag">🇪🇸</span>
      Español
    </button>
    <button class="lang-option" data-lang="en">
      <span class="flag">🇺🇸</span>
      English
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div class="nav-links nav-mobile" id="mobile-menu">
    <a href="/#home" class="nav-link" data-label="nav.home">Inicio</a>
    <a href="/#about" class="nav-link" data-label="nav.about">Sobre mí</a>
    <a href="/#projects" class="nav-link" data-label="nav.projects">Proyectos</a>
    <a href="/#skills" class="nav-link" data-label="nav.skills">Habilidades</a>
    <a href="/#education" class="nav-link" data-label="nav.education">Educación</a>
    <a href="/#contact" class="nav-link" data-label="nav.contact">Contacto</a>
  </div>
</nav>

<style>
  .nav-container {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(20, 20, 20, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .nav-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--fg);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .site-title:hover {
    color: var(--primary-light);
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: var(--primary);
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .site-title:hover .logo-icon {
    transform: rotate(180deg);
  }

  /* Desktop Navigation */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  .nav-link {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    color: var(--fg);
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: var(--primary-light);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Nav Controls Container */
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Language Button */
  .language-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .language-btn:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-light);
    border-color: var(--primary);
  }

  .language-btn svg {
    width: 18px;
    height: 18px;
  }

  .lang-text {
    display: none;
  }

  @media (min-width: 640px) {
    .lang-text {
      display: inline;
    }
  }

  /* Language Dropdown */
  .language-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 1rem;
    background: rgba(17, 17, 17, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    display: none;
    flex-direction: column;
    z-index: 1000;
    animation: slideDown 0.3s ease;
  }

  .language-dropdown.active {
    display: flex;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: var(--fg);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.95rem;
    text-align: left;
  }

  .lang-option:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-light);
  }

  .lang-option.active {
    background: rgba(99, 102, 241, 0.15);
    color: var(--primary-light);
  }

  .flag {
    font-size: 1.25rem;
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--fg);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
  }

  .mobile-menu-btn:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-light);
  }

  .mobile-menu-btn svg {
    width: 24px;
    height: 24px;
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
    .language-btn {
      display: flex;
    }
  }

  /* Mobile Navigation Menu */
  .nav-mobile {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(17, 17, 17, 0.98);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    padding: 1rem;
    gap: 0.5rem;
    animation: slideDown 0.3s ease;
  }

  .nav-mobile.active {
    display: flex;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none !important;
    }
  }

  .nav-mobile .nav-link {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    display: block;
  }

  .nav-mobile .nav-link::after {
    display: none;
  }

  .nav-mobile .nav-link:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-light);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .nav-wrapper {
      padding: 0.75rem;
      height: auto;
    }

    .site-title {
      font-size: 1rem;
    }

    .logo-icon {
      width: 20px;
      height: 20px;
    }

    .language-btn {
      padding: 0.5rem;
    }
  }
</style>

<script>
  import translations from '../i18n/translations.json';
  

  const langBtn = document.getElementById('language-btn');
  const langDropdown = document.getElementById('language-dropdown');
  const langOptions = document.querySelectorAll('.lang-option');
  const navLinks = document.querySelectorAll('[data-label]');

  function getCurrentLanguage(): string {
    if (typeof localStorage !== 'undefined') {
      return localStorage.getItem('language') || 'es';
    }
    return 'es';
  }

  function setLanguage(lang: string): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('language', lang);
    }
    updateUI(lang);
    updateLanguageDropdown(lang);
    document.documentElement.lang = lang;
  }

  function updateUI(lang: string): void {
    // Update nav links
    navLinks.forEach(el => {
      const key = el.getAttribute('data-label');
      if (!key) return;
      
      const keys = key.split('.');
      let value: any = (translations as any)[lang];
      
      for (const k of keys) {
        if (value && typeof value === 'object' && k in value) {
          value = value[k];
        }
      }
      
      if (typeof value === 'string') {
        el.textContent = value;
      }
    });

    // Update language button text
    const langText = document.querySelector('.lang-text');
    if (langText) {
      langText.textContent = lang.toUpperCase();
    }

    // Dispatch custom event for other components to listen
    window.dispatchEvent(new CustomEvent('languagechange', { detail: { language: lang } }));
  }

  function updateLanguageDropdown(lang: string): void {
    langOptions.forEach(opt => {
      if (opt.getAttribute('data-lang') === lang) {
        opt.classList.add('active');
      } else {
        opt.classList.remove('active');
      }
    });
  }

  // Language button click handler
  if (langBtn) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown?.classList.toggle('active');
    });
  }

  // Language option click handlers
  langOptions.forEach(opt => {
    opt.addEventListener('click', (e) => {
      e.stopPropagation();
      const lang = opt.getAttribute('data-lang');
      if (lang) {
        setLanguage(lang);
        langDropdown?.classList.remove('active');
      }
    });
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    if (target && !target.closest('.language-btn') && !target.closest('.language-dropdown')) {
      langDropdown?.classList.remove('active');
    }
  });

  // Mobile Menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('active');
      menuBtn.setAttribute('aria-expanded', mobileMenu.classList.contains('active') ? 'true' : 'false');
    });

    const links = mobileMenu.querySelectorAll('.nav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('click', (event: Event) => {
      const target = event.target as HTMLElement;
      if (target && !target.closest('nav')) {
        mobileMenu.classList.remove('active');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Initialize with saved language
  const savedLang = getCurrentLanguage();
  updateUI(savedLang);
  updateLanguageDropdown(savedLang);
  document.documentElement.lang = savedLang;
</script>