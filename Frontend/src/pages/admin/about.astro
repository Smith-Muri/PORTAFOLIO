---

import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Admin - Sobre Mi">
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800">
    <header class="bg-slate-900 border-b border-slate-700">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-white">Gestionar Sobre Mi</h1>
        <a
          href="/admin/dashboard"
          class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition"
        >
          ← Volver
        </a>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-8 max-w-2xl">
        <form id="aboutForm" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Título</label>
            <input
              type="text"
              id="title"
              class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-blue-500"
              placeholder="Mi Nombre"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Descripción</label>
            <textarea
              id="description"
              rows="6"
              class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-blue-500"
              placeholder="Cuéntame sobre ti..."
            ></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">URL de Imagen de Perfil</label>
            <input
              type="url"
              id="profileImage"
              class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:border-blue-500"
              placeholder="https://..."
            />
          </div>

          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition"
          >
            Guardar Cambios
          </button>
        </form>

        <div id="error" class="mt-4 text-red-400 text-sm hidden"></div>
        <div id="success" class="mt-4 text-green-400 text-sm hidden"></div>
      </div>
    </main>
  </div>

  <script>
    const token = localStorage.getItem("token");
    if (!token) {
      window.location.href = "/admin-login";
    }

    const form = document.getElementById("aboutForm") as HTMLFormElement;
    const errorDiv = document.getElementById("error") as HTMLDivElement;
    const successDiv = document.getElementById("success") as HTMLDivElement;

    async function loadAbout() {
      try {
        const response = await fetch("http://localhost:4000/api/about");
        const data = await response.json();

        if (data.title) {
          (document.getElementById("title") as HTMLInputElement).value = data.title;
          (document.getElementById("description") as HTMLTextAreaElement).value =
            data.description;
          if (data.profileImage) {
            (document.getElementById("profileImage") as HTMLInputElement).value =
              data.profileImage;
          }
        }
      } catch (error) {
        console.error("Error loading about:", error);
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorDiv.classList.add("hidden");
      successDiv.classList.add("hidden");

      const title = (document.getElementById("title") as HTMLInputElement).value;
      const description = (document.getElementById("description") as HTMLTextAreaElement).value;
      const profileImage = (document.getElementById("profileImage") as HTMLInputElement).value;

      if (!title || !description) {
        errorDiv.textContent = "Todos los campos son requeridos";
        errorDiv.classList.remove("hidden");
        return;
      }

      try {
        const response = await fetch("http://localhost:4000/api/about", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ title, description, profileImage }),
        });

        const data = await response.json();

        if (!response.ok) {
          errorDiv.textContent = data.error || "Error al guardar";
          errorDiv.classList.remove("hidden");
          return;
        }

        successDiv.textContent = "¡Cambios guardados exitosamente!";
        successDiv.classList.remove("hidden");
      } catch (error) {
        errorDiv.textContent = "Error de conexión";
        errorDiv.classList.remove("hidden");
      }
    });

    loadAbout();
  </script>
</AdminLayout>
