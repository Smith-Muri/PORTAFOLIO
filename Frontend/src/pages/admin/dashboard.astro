---
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin.css";
import { Settings, FileText, Rocket, Briefcase, Eye, LogOut } from "lucide-astro";
---

<AdminLayout title="Admin Dashboard">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <!-- Navbar -->
    <div class="bg-gradient-to-r from-slate-900/95 to-slate-800/95 border-b border-slate-700/50 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <div>
          <h1 class="section-title-admin text-3xl">⚙️ Panel de Control</h1>
          <p class="text-slate-400 text-xs mt-1">Administra tu portafolio profesional</p>
        </div>
        <button
          id="logoutBtn"
          class="btn-danger-admin flex items-center gap-2 text-sm"
        >
          <LogOut size={18} />
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 py-12">
      <!-- Stats Overview Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
        <div class="card-admin">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-400 font-semibold text-sm">Proyectos</p>
            <span class="text-2xl">🚀</span>
          </div>
          <p id="projectCount" class="text-3xl font-bold text-purple-400">0</p>
          <p class="text-xs text-slate-500 mt-2">Proyectos creados</p>
        </div>

        <div class="card-admin">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-400 font-semibold text-sm">Habilidades</p>
            <span class="text-2xl">⚙️</span>
          </div>
          <p id="skillCount" class="text-3xl font-bold text-indigo-400">0</p>
          <p class="text-xs text-slate-500 mt-2">Skills agregadas</p>
        </div>

        <div class="card-admin">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-400 font-semibold text-sm">Educación</p>
            <span class="text-2xl">🎓</span>
          </div>
          <p id="eduCount" class="text-3xl font-bold text-green-400">0</p>
          <p class="text-xs text-slate-500 mt-2">Registros educativos</p>
        </div>

        <div class="card-admin">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-400 font-semibold text-sm">Estado</p>
            <span class="text-2xl">✓</span>
          </div>
          <p class="text-3xl font-bold text-green-400">Activo</p>
          <p class="text-xs text-slate-500 mt-2">Sistema funcionando</p>
        </div>
      </div>

      <!-- Navigation Cards -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-100 mb-6">🎯 Secciones Administrativas</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <!-- Projects Card -->
          <a href="/admin/projects" class="group">
            <div class="card-admin h-full flex flex-col items-center text-center hover:border-purple-500/50 hover:shadow-2xl hover:shadow-purple-500/10 transition-all duration-300">
              <div class="mb-4 p-3 bg-gradient-to-br from-purple-500/20 to-purple-600/20 rounded-lg group-hover:scale-110 transition-transform">
                <Rocket size={32} class="text-purple-400" />
              </div>
              <h3 class="text-base font-bold text-slate-100">Proyectos</h3>
              <p class="text-slate-400 text-xs mt-2 flex-grow">Gestiona tus trabajos</p>
              <div class="mt-2 text-purple-400 group-hover:text-purple-300 text-sm transition-colors">→ Gestionar</div>
            </div>
          </a>

          <!-- Skills Card -->
          <a href="/admin/skills" class="group">
            <div class="card-admin h-full flex flex-col items-center text-center hover:border-indigo-500/50 hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-300">
              <div class="mb-4 p-3 bg-gradient-to-br from-indigo-500/20 to-indigo-600/20 rounded-lg group-hover:scale-110 transition-transform">
                <Settings size={32} class="text-indigo-400" />
              </div>
              <h3 class="text-base font-bold text-slate-100">Habilidades</h3>
              <p class="text-slate-400 text-xs mt-2 flex-grow">Tus skills técnicos</p>
              <div class="mt-2 text-indigo-400 group-hover:text-indigo-300 text-sm transition-colors">→ Gestionar</div>
            </div>
          </a>

          <!-- Education Card -->
          <a href="/admin/education" class="group">
            <div class="card-admin h-full flex flex-col items-center text-center hover:border-green-500/50 hover:shadow-2xl hover:shadow-green-500/10 transition-all duration-300">
              <div class="mb-4 p-3 bg-gradient-to-br from-green-500/20 to-green-600/20 rounded-lg group-hover:scale-110 transition-transform">
                <Briefcase size={32} class="text-green-400" />
              </div>
              <h3 class="text-base font-bold text-slate-100">Educación</h3>
              <p class="text-slate-400 text-xs mt-2 flex-grow">Tu formación académica</p>
              <div class="mt-2 text-green-400 group-hover:text-green-300 text-sm transition-colors">→ Gestionar</div>
            </div>
          </a>

          <!-- Portfolio Card -->
          <a href="/" target="_blank" class="group">
            <div class="card-admin h-full flex flex-col items-center text-center hover:border-orange-500/50 hover:shadow-2xl hover:shadow-orange-500/10 transition-all duration-300">
              <div class="mb-4 p-3 bg-gradient-to-br from-orange-500/20 to-orange-600/20 rounded-lg group-hover:scale-110 transition-transform">
                <Eye size={32} class="text-orange-400" />
              </div>
              <h3 class="text-base font-bold text-slate-100">Portfolio</h3>
              <p class="text-slate-400 text-xs mt-2 flex-grow">Sitio público</p>
              <div class="mt-2 text-orange-400 group-hover:text-orange-300 text-sm transition-colors">→ Ver</div>
            </div>
          </a>
        </div>
      </div>

      <!-- System Status Section -->
      <div class="form-container-admin">
        <h2 class="text-2xl font-bold text-slate-100 mb-8 flex items-center gap-2">
          <span>📊</span> Estado del Sistema
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Backend Status -->
          <div class="card-admin">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="text-slate-400 font-semibold text-sm">Backend</p>
                <p class="text-slate-100 font-bold text-lg mt-1">localhost:4000</p>
              </div>
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
            </div>
            <p class="text-green-400 text-sm">✓ Activo y funcionando</p>
          </div>

          <!-- Database Status -->
          <div class="card-admin">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="text-slate-400 font-semibold text-sm">Base de Datos</p>
                <p class="text-slate-100 font-bold text-lg mt-1">SQLite</p>
              </div>
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
            </div>
            <p class="text-green-400 text-sm">✓ Conectada y sincronizada</p>
          </div>
          <!-- Auth Status -->
          <div class="card-admin">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="text-slate-400 font-semibold text-sm">Autenticación</p>
                <p class="text-slate-100 font-bold text-lg mt-1">JWT</p>
              </div>
              <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
            </div>
            <p class="text-green-400 text-sm">✓ Sesión segura activa</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem("token");
    if (!token) {
      window.location.href = "/admin-login";
    }

    // Cargar estadísticas
    async function loadStats() {
      try {
        const projectsRes = await fetch("http://localhost:4000/api/projects");
        const projects = await projectsRes.json();
        document.getElementById("projectCount")!.textContent = projects.length;

        const skillsRes = await fetch("http://localhost:4000/api/skills");
        const skills = await skillsRes.json();
        document.getElementById("skillCount")!.textContent = skills.length;

        const eduRes = await fetch("http://localhost:4000/api/education");
        const education = await eduRes.json();
        document.getElementById("eduCount")!.textContent = education.length;
      } catch (e) {
        console.error("Error loading stats:", e);
      }
    }

    loadStats();

    document.getElementById("logoutBtn")!.addEventListener("click", () => {
      localStorage.removeItem("token");
      window.location.href = "/admin-login";
    });
  </script>
</AdminLayout>
