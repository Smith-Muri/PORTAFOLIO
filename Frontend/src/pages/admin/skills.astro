---
// Admin - Skills
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin.css";
---

<AdminLayout title="Admin - Skills">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <!-- Navbar -->
    <nav class="admin-navbar sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="text-slate-400 hover:text-white transition-colors">← Dashboard</a>
          <h1 class="section-title-admin">⚙️ Habilidades</h1>
        </div>
        <button id="logoutBtn" class="btn-danger-admin">
          Salir
        </button>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Form -->
        <div class="lg:col-span-1">
          <div class="form-container-admin sticky top-24">
            <h2 class="text-xl font-bold text-slate-100 mb-6" id="formTitle">➕ Nueva Habilidad</h2>

            <form id="skillForm" class="space-y-5">
              <input type="hidden" id="skillId" />

              <div class="form-group-admin">
                <label>Nombre de la Habilidad *</label>
                <input
                  type="text"
                  id="name"
                  placeholder="JavaScript, React, etc."
                  class="admin-input"
                  required
                />
              </div>

              <div class="form-group-admin">
                <label>Categoría (Opcional)</label>
                <input
                  type="text"
                  id="category"
                  placeholder="Frontend / Backend / DevOps"
                  class="admin-input"
                />
              </div>

              <button type="submit" class="w-full btn-primary-admin mt-2">
                💾 Guardar Habilidad
              </button>

              <button
                type="button"
                id="cancelBtn"
                class="w-full btn-secondary-admin hidden"
              >
                ✕ Cancelar
              </button>
            </form>

            <div id="message" class="mt-4 alert-admin hidden"></div>
          </div>
        </div>

        <!-- List -->
        <div class="lg:col-span-2">
          <h3 class="text-2xl font-bold text-slate-100 mb-6">🎯 Tus Habilidades</h3>
          <div id="skillsList" class="space-y-3"></div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>

  <script>
    declare const feather: any;
    // Mapa de iconos por skill
    const skillIcons: Record<string, string> = {
      // Lenguajes
      "javascript": "code",
      "typescript": "code",
      "python": "code",
      "java": "code",
      "c#": "code",
      "c++": "code",
      "php": "code",
      "ruby": "code",
      "golang": "code",
      "rust": "code",
      
      // Frontend
      "react": "layers",
      "vue": "layers",
      "angular": "layers",
      "svelte": "layers",
      "html": "code",
      "css": "code",
      "tailwind": "palette",
      "bootstrap": "layout",
      "sass": "palette",
      "webpack": "package",
      
      // Backend
      "node.js": "server",
      "nodejs": "server",
      "express": "server",
      "django": "server",
      "flask": "server",
      "fastapi": "server",
      "spring": "server",
      "laravel": "server",
      "dotnet": "server",
      ".net": "server",
      
      // Databases
      "sql": "database",
      "mysql": "database",
      "postgresql": "database",
      "mongodb": "database",
      "firebase": "database",
      "redis": "database",
      
      // DevOps
      "docker": "box",
      "kubernetes": "box",
      "aws": "cloud",
      "gcp": "cloud",
      "azure": "cloud",
      "git": "git-branch",
      "linux": "terminal",
      
      // Other
      "graphql": "layers",
      "rest": "api",
      "api": "api",
      "testing": "check-circle",
      "jest": "check-circle",
    };

    function getIconForSkill(skillName: string): string {
      const normalized = skillName.toLowerCase().trim();
      for (const [key, icon] of Object.entries(skillIcons)) {
        if (normalized.includes(key) || key.includes(normalized)) {
          return icon;
        }
      }
      return "zap"; // Icon por defecto
    }

    const BACKEND_URL = "http://localhost:4000";
    let skills: any[] = [];
    let editingId: string | null = null;

    function getToken() {
      return localStorage.getItem("token") || "";
    }

    function checkAuth() {
      if (!getToken()) {
        window.location.href = "/admin-login";
      }
    }

    function showMessage(msg: string, type: "success" | "error") {
      const el = document.getElementById("message")!;
      el.textContent = msg;
      el.className =
        "mt-4 alert-admin " +
        (type === "success" ? "alert-success" : "alert-error");
      el.classList.remove("hidden");
      setTimeout(() => el.classList.add("hidden"), 4000);
    }

    async function loadSkills() {
      try {
        const res = await fetch(`${BACKEND_URL}/api/skills`);
        skills = await res.json();
        render();
      } catch (e) {
        console.error(e);
      }
    }

    function render() {
      document.getElementById("skillsList")!.innerHTML = skills
        .map((s) => {
          const iconName = getIconForSkill(s.name);
          return `
            <div class="card-admin">
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-3 flex-1">
                  <div class="p-2 bg-indigo-500/20 rounded-lg">
                    <i data-feather="${iconName}" class="w-6 h-6 text-indigo-400"></i>
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-100">${s.name}</h3>
                    <p class="text-sm text-slate-400">${s.category || "Técnica"}</p>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button onclick="edit('${s.id}')" class="btn-primary-admin px-3 py-1 text-xs">✏️</button>
                  <button onclick="del('${s.id}')" class="btn-danger-admin px-3 py-1 text-xs">🗑️</button>
                </div>
              </div>
            </div>
          `;
        })
        .join("");
      if (typeof feather !== 'undefined') {
        feather.replace();
      }
    }

    function edit(id: string) {
      const skill = skills.find((s) => s.id == id);
      if (!skill) return;

      (document.getElementById("skillId") as HTMLInputElement).value = id;
      (document.getElementById("name") as HTMLInputElement).value = skill.name;
      (document.getElementById("category") as HTMLInputElement).value = skill.category || "";

      document.getElementById("formTitle")!.textContent = "✏️ Editar Habilidad";
      document.getElementById("cancelBtn")!.classList.remove("hidden");

      editingId = id;
      document.querySelector(".sticky")!.scrollIntoView({ behavior: "smooth" });
    }

    function del(id: string) {
      if (!confirm("¿Eliminar?")) return;
      fetch(`${BACKEND_URL}/api/skills/${id}`, {
        method: "DELETE",
        headers: { Authorization: `Bearer ${getToken()}` },
      })
        .then(() => {
          loadSkills();
          showMessage("Eliminada", "success");
        })
        .catch(() => showMessage("Error", "error"));
    }

    document.getElementById("skillForm")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = (document.getElementById("name") as HTMLInputElement).value;
      const category = (document.getElementById("category") as HTMLInputElement).value;

      if (!name) {
        showMessage("Completa los campos requeridos", "error");
        return;
      }

      try {
        const method = editingId ? "PUT" : "POST";
        const url = editingId ? `${BACKEND_URL}/api/skills/${editingId}` : `${BACKEND_URL}/api/skills`;

        const res = await fetch(url, {
          method,
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${getToken()}`,
          },
          body: JSON.stringify({ name, level: 3, category }),
        });

        if (res.ok) {
          showMessage(editingId ? "Actualizada" : "Creada", "success");
          resetForm();
          loadSkills();
        } else {
          showMessage("Error", "error");
        }
      } catch (e) {
        showMessage("Error de conexión", "error");
      }
    });

    function resetForm() {
      (document.getElementById("skillForm") as HTMLFormElement).reset();
      (document.getElementById("skillId") as HTMLInputElement).value = "";
      document.getElementById("formTitle")!.textContent = "➕ Nueva Habilidad";
      document.getElementById("cancelBtn")!.classList.add("hidden");
      editingId = null;
    }

    document.getElementById("cancelBtn")!.addEventListener("click", resetForm);
    document.getElementById("logoutBtn")!.addEventListener("click", () => {
      localStorage.removeItem("token");
      window.location.href = "/admin-login";
    });

    checkAuth();
    loadSkills();

    (window as any).edit = edit;
    (window as any).del = del;
  </script>
</AdminLayout>
