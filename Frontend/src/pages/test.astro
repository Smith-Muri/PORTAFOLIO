---
// Página de prueba de conexión
import Layout from "../layouts/Layout.astro";
---

<Layout title="Test Backend">
  <div class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800 flex items-center justify-center px-4">
    <div class="w-full max-w-2xl bg-slate-800 rounded-lg shadow-xl p-8 border border-slate-700">
      <h1 class="text-3xl font-bold text-white mb-6">🧪 Test de Conexión Backend</h1>

      <div class="space-y-6">
        <!-- Test 1: Backend Status -->
        <div class="bg-slate-700 rounded-lg p-4">
          <h2 class="text-xl font-semibold text-white mb-3">1. Estado del Backend</h2>
          <button
            id="testBackend"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition"
          >
            Verificar Conexión
          </button>
          <div id="backendResult" class="mt-3 p-3 bg-slate-600 rounded text-white hidden">
            <p id="backendText"></p>
          </div>
        </div>

        <!-- Test 2: GET /api/about -->
        <div class="bg-slate-700 rounded-lg p-4">
          <h2 class="text-xl font-semibold text-white mb-3">2. GET /api/about</h2>
          <button
            id="testAbout"
            class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition"
          >
            Obtener datos
          </button>
          <div id="aboutResult" class="mt-3 p-3 bg-slate-600 rounded text-white hidden">
            <pre id="aboutText" class="text-sm overflow-auto"></pre>
          </div>
        </div>

        <!-- Test 3: Test Register -->
        <div class="bg-slate-700 rounded-lg p-4">
          <h2 class="text-xl font-semibold text-white mb-3">3. Crear Usuario de Prueba</h2>
          <div class="space-y-3 mb-3">
            <input
              type="email"
              id="testEmail"
              placeholder="email@test.com"
              class="w-full px-3 py-2 bg-slate-600 border border-slate-500 rounded text-white placeholder-slate-400"
            />
            <input
              type="password"
              id="testPassword"
              placeholder="password123"
              class="w-full px-3 py-2 bg-slate-600 border border-slate-500 rounded text-white placeholder-slate-400"
            />
          </div>
          <button
            id="testRegister"
            class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition"
          >
            Registrar
          </button>
          <div id="registerResult" class="mt-3 p-3 bg-slate-600 rounded text-white hidden">
            <p id="registerText"></p>
          </div>
        </div>

        <!-- Status Panel -->
        <div class="bg-slate-700 rounded-lg p-4">
          <h2 class="text-xl font-semibold text-white mb-3">📊 Estado Actual</h2>
          <div class="space-y-2 text-sm">
            <p><span class="font-semibold">Frontend:</span> <span id="frontendStatus" class="text-yellow-400">localhost:4321</span></p>
            <p><span class="font-semibold">Backend esperado:</span> <span class="text-yellow-400">localhost:4000</span></p>
            <p><span class="font-semibold">Conexión:</span> <span id="connectionStatus" class="text-red-400">Verificando...</span></p>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-600">
        <a
          href="/admin-login"
          class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition"
        >
          ← Volver al Login
        </a>
      </div>
    </div>
  </div>

  <script>
    const BACKEND_URL = "http://localhost:4000";

    // Test Backend
    document.getElementById("testBackend")!.addEventListener("click", async () => {
      const result = document.getElementById("backendResult")!;
      const text = document.getElementById("backendText")!;

      try {
        const response = await fetch(`${BACKEND_URL}/api/about`);
        if (response.ok) {
          text.textContent = "✓ Backend respondiendo correctamente en " + BACKEND_URL;
          result.className = "mt-3 p-3 bg-green-600 rounded text-white";
          updateConnectionStatus(true);
        } else {
          text.textContent = "✗ Backend respondió con error: " + response.status;
          result.className = "mt-3 p-3 bg-red-600 rounded text-white";
          updateConnectionStatus(false);
        }
      } catch (error) {
        text.textContent = "✗ No se puede conectar al backend en " + BACKEND_URL;
        result.className = "mt-3 p-3 bg-red-600 rounded text-white";
        updateConnectionStatus(false);
      }
      result.classList.remove("hidden");
    });

    // Test GET /api/about
    document.getElementById("testAbout")!.addEventListener("click", async () => {
      const result = document.getElementById("aboutResult")!;
      const text = document.getElementById("aboutText")!;

      try {
        const response = await fetch(`${BACKEND_URL}/api/about`);
        const data = await response.json();
        text.textContent = JSON.stringify(data, null, 2);
        result.className = "mt-3 p-3 bg-green-600 rounded text-white hidden";
      } catch (error) {
        text.textContent = "Error: " + (error as Error).message;
        result.className = "mt-3 p-3 bg-red-600 rounded text-white";
      }
      result.classList.remove("hidden");
    });

    // Test Register
    document.getElementById("testRegister")!.addEventListener("click", async () => {
      const email = (document.getElementById("testEmail") as HTMLInputElement).value;
      const password = (document.getElementById("testPassword") as HTMLInputElement).value;
      const result = document.getElementById("registerResult")!;
      const text = document.getElementById("registerText")!;

      if (!email || !password) {
        text.textContent = "Por favor completa email y contraseña";
        result.className = "mt-3 p-3 bg-yellow-600 rounded text-white";
        result.classList.remove("hidden");
        return;
      }

      try {
        const response = await fetch(`${BACKEND_URL}/api/auth/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password }),
        });
        const data = await response.json();

        if (response.ok) {
          text.textContent = "✓ Usuario registrado. Ahora puedes iniciar sesión";
          result.className = "mt-3 p-3 bg-green-600 rounded text-white";
        } else {
          text.textContent = "✗ Error: " + (data.error || "No se pudo registrar");
          result.className = "mt-3 p-3 bg-red-600 rounded text-white";
        }
      } catch (error) {
        text.textContent = "✗ Error de conexión: " + (error as Error).message;
        result.className = "mt-3 p-3 bg-red-600 rounded text-white";
      }
      result.classList.remove("hidden");
    });

    function updateConnectionStatus(connected: boolean) {
      const status = document.getElementById("connectionStatus")!;
      if (connected) {
        status.textContent = "✓ Conectado";
        status.className = "text-green-400";
      } else {
        status.textContent = "✗ No conectado";
        status.className = "text-red-400";
      }
    }

    // Auto-test on load
    window.addEventListener("load", () => {
      (document.getElementById("testBackend") as HTMLButtonElement).click();
    });
  </script>
</Layout>
