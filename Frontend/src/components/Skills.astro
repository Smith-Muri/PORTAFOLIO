---
import {
  Code2,
  Palette,
  Braces,
  Atom,
  Server,
  GitBranch,
  Database,
  Coffee,
  Zap,
  Terminal,
  FileJson,
  Shield
} from "lucide-astro";

interface Skill {
  name: string;
  color: string;
}

const skillIconMap: Record<string, { icon: any; color: string }> = {
  "HTML": { icon: Code2, color: "text-orange-500" },
  "CSS": { icon: Palette, color: "text-blue-500" },
  "JavaScript": { icon: Zap, color: "text-yellow-400" },
  "TypeScript": { icon: FileJson, color: "text-blue-600" },
  "React": { icon: Atom, color: "text-cyan-400" },
  "Node.js": { icon: Server, color: "text-green-500" },
  "Git": { icon: GitBranch, color: "text-red-500" },
  "SQL": { icon: Database, color: "text-blue-400" },
  "SQL Server": { icon: Database, color: "text-blue-400" },
  "MongoDB": { icon: Database, color: "text-green-600" },
  "PostgreSQL": { icon: Database, color: "text-blue-700" },
  "Java": { icon: Coffee, color: "text-orange-600" },
  "Python": { icon: Braces, color: "text-blue-500" },
  "Docker": { icon: Terminal, color: "text-blue-400" },
  "C++": { icon: Code2, color: "text-blue-800" },
  "REST API": { icon: Braces, color: "text-purple-500" },
  "Express": { icon: Server, color: "text-gray-400" },
  "Astro": { icon: Atom, color: "text-purple-600" },
  "Tailwind CSS": { icon: Palette, color: "text-cyan-500" },
  "Authentication": { icon: Shield, color: "text-green-500" },
};

let apiSkills = [];

try {
  const res = await fetch("http://localhost:4000/api/skills");
  apiSkills = await res.json();
} catch (e) {
  console.error("Error loading skills:", e);
}

const defaultSkills = [
  { name: "HTML", color: "text-orange-500" },
  { name: "CSS", color: "text-blue-500" },
  { name: "JavaScript", color: "text-yellow-400" },
  { name: "React", color: "text-cyan-400" },
  { name: "Node.js", color: "text-green-500" },
  { name: "Git", color: "text-red-500" },
];

const skills: Skill[] = (apiSkills.length > 0 ? apiSkills : defaultSkills).map((s: any) => ({
  name: s.name || s,
  color: skillIconMap[s.name || s]?.color || "text-gray-400",
}));

const getIconComponent = (skillName: string) => {
  return skillIconMap[skillName]?.icon || Braces;
};
---

<section id="skills" class="py-20 relative">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-white mb-12 flex items-center gap-3" data-label="skills.title">
      <GitBranch class="w-8 h-8 text-red-500" />
      Habilidades Técnicas
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {skills.map(({ name, color }: Skill) => {
        const IconComponent = getIconComponent(name);
        return (
          <div class="group bg-white/5 border border-white/10 rounded-xl p-6 flex flex-col items-center justify-center gap-4 hover:bg-white/10 hover:border-red-500/50 transition-all duration-300 hover:-translate-y-1">
            <IconComponent class={`w-8 h-8 ${color} transition-transform duration-300 group-hover:scale-110`} />
            <span class="text-gray-300 font-medium group-hover:text-white text-sm text-center">
              {name}
            </span>
          </div>
        );
      })}
    </div>
  </div>
</section>
